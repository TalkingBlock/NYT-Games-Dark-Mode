{
  "name": "NYT Games Dark Mode",
  "description": "Applies Dark Mode to all of the website NYT Games!",
  "version": "0.1.4",
  "manifest_version": 3,
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/nytdark48.png",
    "128": "icons/nytdark128.png"
  },
  "content_scripts": [
    {
      "matches": [
      "https://www.nytimes.com/crosswords/game/mini/*",
      "https://www.nytimes.com/crosswords/game/daily/*"
      ],
      "js": ["crossword.js"],
      "css": ["crossword.css"]
    }, {
      "matches": ["https://www.nytimes.com/crosswords"],
      "css": ["menu.css"]
    }
  ]
}