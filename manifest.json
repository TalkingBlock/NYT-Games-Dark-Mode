{
  "name": "NYT Games Dark Mode",
  "description": "Adds a toggleable dark mode to NYT Games :D",
  "version": "0.8.5",
  "manifest_version": 3,
  "permissions": ["scripting", "activeTab", "storage", "clipboardRead", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/nytdark16.png",
    "32": "icons/nytdark32.png",
    "48": "icons/nytdark48.png",
    "128": "icons/nytdark128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/crosswords/game/daily*",
                  "https://www.nytimes.com/crosswords/game/bonus*",
                  "https://www.nytimes.com/games/bonus/crossword/monthly/*",
                  "https://www.nytimes.com/games/bonus/crossword/easy-mode/*"],
      "js": ["scripts/misc/crosswordColors.js", "scripts/games/theCrossword.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/crosswords/game/midi*"],
      "js": ["scripts/misc/crosswordColors.js", "scripts/games/midiCrossword.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/crosswords/game/mini*",
                  "https://www.nytimes.com/games/bonus/crossword/mini/*"],
      "js": ["scripts/misc/crosswordColors.js", "scripts/games/miniCrossword.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/connections",
                  "https://www.nytimes.com/games/connections/20*",
                  "https://www.nytimes.com/games/connections?utm_source=wordle&utm_medium=referral&utm_campaign=wordle_nav",
                  "https://www.nytimes.com/games/bonus/connections/3x3/*"],
      "js": ["scripts/misc/connectionsColors.js", "scripts/games/connections.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/spelling-bee",
                  "https://www.nytimes.com/puzzles/spelling-bee/20*",
                  "https://www.nytimes.com/puzzles/spelling-bee?utm_source=wordle&utm_medium=referral&utm_campaign=wordle_nav"],
      "js": ["scripts/games/spellingBee.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/wordle/*"],
      "js": ["scripts/misc/wordleColors.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/pips*"],
      "js": ["scripts/games/pips.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/strands",
                  "https://www.nytimes.com/games/strands/20*",
                  "https://www.nytimes.com/games/strands?utm_source=wordle&utm_medium=referral&utm_campaign=wordle_nav",
                  "https://www.nytimes.com/games/bonus/strands/*"],
      "js": ["scripts/games/strands.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/letter-boxed*"],
      "js": ["scripts/games/letterBoxed.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/tiles*"],
      "js": ["scripts/games/tiles.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/sudoku*"],
      "js": ["scripts/misc/sudokuColors.js", "scripts/games/sudoku.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/crosswords/archive*"],
      "js": ["scripts/games/crosswordsArchive.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/connections/archive*"],
      "js": ["scripts/games/connectionsArchive.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/spelling-bee/hub*"],
      "js": ["scripts/games/spellingBeeArchive.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/wordle/archive/*"],
      "js": ["scripts/games/wordleArchive.js"],
      "run_at": "document_start"
    }, {  
      "matches": ["https://www.nytimes.com/games/strands/archive/*"],
      "js": ["scripts/games/strandsArchive.js"],
      "run_at": "document_start"
    }, { 
      "matches": ["https://www.nytimes.com/crosswords",
                  "https://www.nytimes.com/crosswords?utm_campaign=wordle_nav&utm_medium=referral&utm_source=wordle"],
      "js": ["scripts/games/menu.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/puzzles/stats",
                  "https://www.nytimes.com/puzzles/stats?login=smartlock&auth=login-smartlock"],
      "js": ["scripts/games/crosswordStats.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/create/wordle",
                  "https://www.nytimes.com/games/create/wordle?login=smartlock&auth=login-smartlock"],
      "js": ["scripts/games/customWordle.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/athletic/connections-sports-edition/"],
      "js": ["scripts/games/taConnections.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://www.nytimes.com/games/crossplay",
                  "https://www.nytimes.com/games/bonus/hub/*"],
      "js": ["scripts/misc/miscPages.js"],
      "run_at": "document_start"
    }, {
      "matches": ["https://myaccount.nytimes.com/auth/iframe/*"],
      "js": ["scripts/misc/iframe.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["svgs/*", "mp4s/*", "imgs/*"],
      "matches": ["https://www.nytimes.com/*"]
    }
  ]
}